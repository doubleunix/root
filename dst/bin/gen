#!/bin/sh
set -eu

http() (
    set -o pipefail
    : "${GEN_MODEL:?set GEN_MODEL to the model name}"
    if [ -n "${GEN_KEY:-}" ]; then
        # Keep the credential out of the process argument list.
        set -- --header @/dev/fd/3
    else
        set --
    fi
    if [ -n "${GEN_SOCKET:-}" ]; then set -- "$@" --unix-socket "$GEN_SOCKET"; fi
    jq -Rs --arg model "$GEN_MODEL" --arg effort "${GEN_EFFORT:-xhigh}" \
        --arg reasoning "${GEN_REASONING:-1}" '
        {model:$model,messages:[{role:"user",content:.}]}
        + if $reasoning == "1" then {reasoning_effort:$effort} else {} end' |
        curl --fail-with-body -sS --max-time 300 "$@" --header 'Content-Type: application/json' \
            --data-binary @- "$GEN_URL" 3<<HEADER |
Authorization: Bearer ${GEN_KEY:-}
HEADER
        jq -er '.choices[0].message.content | select(type == "string" and length > 0)'
)

backend() {
    if [ -n "${GEN_AGENT:-}" ]; then
        "$GEN_AGENT"
    elif [ -n "${GEN_URL:-}" ]; then
        http
    else
        /lib/ix/gen-codex
    fi
}

case ${1:-} in
    ask) export GEN_EFFORT=${2:-xhigh}; backend; exit ;;
    agent) shift ;;
    list|fetch|install)
        action=$1
        shift
        case $action:$# in
            list:0) exec make -C /src ls-ports ;;
            fetch:0) exec make -C /src fetch-all ;;
            fetch:1|install:1) exec make -C /src "$action" "PORT=$1" ;;
        esac
        exit 2
        ;;
    -h|--help|'')
        printf '%s\n' 'gen ask [EFFORT]      send stdin to the backend' \
            'gen list | fetch | install ORG/REPO' \
            'Run yhwh auth login to use Codex, or set GEN_AGENT or GEN_URL and GEN_MODEL.'
        exit
        ;;
    *) printf '%s\n' 'Try gen --help.' >&2; exit 2 ;;
esac

export GEN_EFFORT=$1 GEN_MODE=$2
shift 2
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
{
    cat /lib/ix/agent
    printf '\nCurrent directory: %s\nUID: %s\nMode: %s\n' "$PWD" "$(id -u)" "$GEN_MODE"
    if [ -n "${NSH_PROGRAM:-}" ]; then
        printf '\nProgram:\n'
        cat -- "$NSH_PROGRAM"
    fi
    printf '\nRequest:\n%s\n' "$*"
    if [ ! -t 0 ]; then cat; fi
} > "$work/prompt"

tab=$(printf '\t')
step=0
while [ "$step" -lt 24 ]; do
    step=$((step + 1))
    backend < "$work/prompt" > "$work/reply"
    first=$(sed -n '1{s/[[:space:]]*$//;p;}' "$work/reply")
    case $first in
        '@sh'|'@ask')
            sed '1d' "$work/reply" > "$work/body"
            if [ "$GEN_MODE" = text ]; then cat "$work/body"; exit; fi
            ;;
        '@fail') sed '1d' "$work/reply" >&2; exit 1 ;;
        *) cat "$work/reply"; exit ;;
    esac

    if [ "$first" = '@ask' ]; then
        cat "$work/body" >&2
        if ! ( : </dev/tty ) 2>/dev/null; then exit 2; fi
        printf 'yhwh> ' >&2
        IFS= read -r answer </dev/tty || exit 2
        case $answer in :cancel) exit 2 ;; esac
        printf '\nAgent question:\n%s\nUser answer:\n%s\n' "$(cat "$work/body")" "$answer" >> "$work/prompt"
        continue
    fi

    printf '\n' >&2
    sed "s/^/$tab/" "$work/body" >&2
    if [ "$GEN_MODE" = review ]; then
        if ! ( : </dev/tty ) 2>/dev/null; then exit 2; fi
        printf 'Run it? [y/N] ' >&2
        IFS= read -r answer </dev/tty || exit 2
        case $answer in y|Y|yes) ;; *) exit 2 ;; esac
    fi
    input=/dev/null
    if ( : </dev/tty ) 2>/dev/null; then input=/dev/tty; fi
    set -o pipefail
    status=0
    (unset GEN_KEY; /bin/sh "$work/body" < "$input") 2>&1 | tee "$work/output" >&2 || status=$?
    {
        printf '\nShell step:\n'
        cat "$work/body"
        printf '\nExit status: %s\nLast output:\n' "$status"
        tail -c 16384 "$work/output"
        printf '\n'
    } >> "$work/prompt"
done
printf '%s\n' 'gen: stopped after 24 turns.' >&2
exit 1
