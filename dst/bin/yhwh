#!/bin/sh
set -eu
case ${1:-} in
    -h|--help)
        printf '%s\n' 'yhwh REQUEST                    ask and do' \
            'yhwh install sl from arch      install a package and link a command into /usr/bin' \
            'yhwh turn REQUEST              answer in text' \
            'yhwh shell                     enter nsh' \
            'yhwh el | open [PATH]           open YHWH in this directory' \
            'yhwh auth login | status | logout' \
            'yhwh list | fetch ORG/REPO | install ORG/REPO'
        exit ;;
    el) shift; exec /lib/ix/yhwh-el "$@" ;;
    open)
        shift
        interface=el
        if [ -r /etc/yhwh-open ]; then read -r interface < /etc/yhwh-open || :; fi
        case ${interface:-el} in
            el) exec /lib/ix/yhwh-el "$@" ;;
            open|yhwh) printf 'yhwh: recursive interface in /etc/yhwh-open\n' >&2; exit 2 ;;
            *) exec "$interface" "$@" ;;
        esac
        ;;
    auth)
        shift
        if [ -z "${1:-}" ]; then set -- --help; fi
        exec /lib/ix/gen-codex "$@"
        ;;
    shell|-l) shift; exec nsh "$@" ;;
    -c|-lc) exec /bin/sh "$@" ;;
    turn) shift; exec lord -n -- "$@" ;;
    relay) shift; exec gen ask "${1:-xhigh}" ;;
    list|fetch) exec gen "$@" ;;
    install)
        if [ "$#" -eq 4 ] && [ "$3" = from ]; then
            case $4 in
                arch|pacman) exec ix-world add arch "$2" ;;
                gentoo|emerge) exec ix-world add gentoo "$2" ;;
                nix) exec ix-world add nix "$2" ;;
            esac
        fi
        if [ "$#" -eq 2 ]; then
            case $2 in */*) exec gen "$@" ;; esac
        fi
        ;;
    '') if [ -t 0 ]; then exec nsh; fi ;;
esac
exec lord "$@"
