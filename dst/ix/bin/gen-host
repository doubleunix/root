#!/usr/bin/env python3
"""Let a chroot send a prompt to a model already available to its caller."""
import http.server
import json
import os
import shutil
import socketserver
import subprocess
import sys
import tempfile
import threading


class Prompt(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        try:
            size = int(self.headers["Content-Length"])
            if not 0 < size <= 1024 * 1024:
                self.send_error(413)
                return
            request = json.loads(self.rfile.read(size))
            prompt = request["messages"][0]["content"]
            reply = subprocess.run(
                [self.server.backend],
                input=prompt,
                stdout=subprocess.PIPE,
                text=True,
                check=True,
                cwd=self.server.directory,
                env={**os.environ, "GEN_EFFORT": request.get("reasoning_effort", "xhigh")},
            )
        except (ValueError, TypeError, KeyError, IndexError):
            self.send_error(400)
            return
        except (OSError, subprocess.CalledProcessError):
            self.send_error(502)
            return

        body = json.dumps({"choices": [{"message": {"content": reply.stdout}}]}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *_):
        pass


def main(backend, command):
    executable = shutil.which(backend)
    if executable is None:
        raise SystemExit(f"ix: GEN_HOST is not executable: {backend}")
    # Only the chroot invocation gets access to this socket. Keep the model
    # login with the host user who launched it, before ix enters sudo.
    with tempfile.TemporaryDirectory(prefix="ix-gen-", dir="/tmp") as directory:
        address = f"{directory}/gen"
        with socketserver.UnixStreamServer(address, Prompt) as server:
            os.chmod(address, 0o600)
            server.backend = os.path.abspath(executable)
            server.directory = directory
            thread = threading.Thread(target=server.serve_forever, daemon=True)
            thread.start()
            try:
                return subprocess.call(command, env={**os.environ, "IX_GEN_SOCKET": address})
            finally:
                server.shutdown()
                thread.join()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1], sys.argv[2:]))
