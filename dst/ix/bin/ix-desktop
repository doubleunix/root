#!/bin/bash
set -euo pipefail
app=/opt/yhwh
if [[ ${1:-} == --install ]]; then
    # Keep the native npm ci tree with the built app. The upstream installer
    # repacks it and asks npm to resolve its unbundled dependencies offline.
    cd /ix-src/yhwh
    node node_modules/electron/install.js
    # Linux x86-64 can need a native build of the terminal's PTY addon.
    if ! node -e 'require("node-pty")' >/dev/null 2>&1; then
        npm --prefix node_modules/node-pty run install
        npm --prefix node_modules/node-pty run postinstall
    fi
    node -e 'require("node-pty")'
    release=$(mktemp -d /opt/yhwh.XXXXXXXX)
    trap 'rm -rf -- "$release"' EXIT
    chmod 755 "$release"
    cp -a --reflink=auto bin etc lib src node_modules package.json "$release/"
    mkdir -p "$release/var/tmp"
    cp -a --reflink=auto var/tmp/yhwh "$release/var/tmp/"
    runtime=$release/node_modules/electron/dist
    test -x "$runtime/electron"
    test -f "$runtime/chrome-sandbox"
    test ! -L "$runtime/chrome-sandbox"
    # Linux blocks Chromium's unprivileged user namespace inside a chroot.
    # Use the sandbox helper from the same verified Electron download.
    chown root:root "$release/node_modules" "$release/node_modules/electron" "$runtime" "$runtime/chrome-sandbox"
    chmod go-w "$release/node_modules" "$release/node_modules/electron" "$runtime"
    chmod 4755 "$runtime/chrome-sandbox"
    ln -sfnT "${release##*/}" "$app"
    trap - EXIT
    echo "YHWH installed at $release"
    exit
fi

export YHWH_ELECTRON=$app/node_modules/electron/dist/electron
if [[ ${1:-} == --smoke ]]; then
    test_dir=$(mktemp -d /tmp/yhwh-smoke.XXXXXX)
    trap 'rm -rf -- "$test_dir"' EXIT
    chmod 755 "$test_dir"
    install -d -o ix-desktop -m 700 "$test_dir/profile"
    cat > "$test_dir/main.cjs" <<'JS'
const { app } = require('electron');
const installedApp = '/opt/yhwh/src/yhwh-default';
app.setAppPath(installedApp);
app.on('browser-window-created', (_, window) => {
  window.webContents.on('did-finish-load', () => {
    if (window.webContents.getURL().endsWith('/etc/default/index.html')) {
      console.log('YHWH desktop loaded its renderer');
      app.exit(0);
    }
  });
});
require(installedApp + '/app/main.cjs');
JS
    cd /home/ix-desktop
    timeout 45s runuser -u ix-desktop -- env YHWH_DATA_DIR="$test_dir/profile" \
        dbus-run-session -- xvfb-run -a "$YHWH_ELECTRON" "$test_dir/main.cjs"
    exit
fi
cd /home/ix-desktop
if [[ -n ${DISPLAY:-} && -s /dev/shm/ix.Xauthority ]]; then
    cookie_dir=$(mktemp -d /tmp/yhwh-x11.XXXXXX)
    trap 'rm -rf -- "$cookie_dir"' EXIT
    chown ix-desktop "$cookie_dir"
    install -m 600 -o ix-desktop /dev/shm/ix.Xauthority "$cookie_dir/authority"
    runuser -u ix-desktop -- env XAUTHORITY="$cookie_dir/authority" dbus-run-session -- "$app/bin/yhwh-default" "$@"
    exit
fi
exec runuser -u ix-desktop -- dbus-run-session -- "$app/bin/yhwh-default" "$@"
