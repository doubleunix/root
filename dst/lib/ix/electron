#!/bin/sh
# Chromium requires this flag when the caller is root.
if [ "$(id -u)" = 0 ]; then set -- --no-sandbox "$@"; fi
runtime=/pkg/arch/opt/yhwh/runtime
# Some Arch libraries have their own RUNPATH, which overrides inherited RPATH.
export LD_LIBRARY_PATH="$runtime/electron:/pkg/arch/usr/lib"
exec "$runtime/electron/electron" "$@"
