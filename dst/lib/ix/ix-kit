#!/bin/sh
set -eu
kit=/pkg/alpine

install() (
    if [ ! -f "$kit/.ix-seed" ]; then
        (unset ARCHIVE MAKEFLAGS; make --no-print-directory -C /src/alpine bootstrap)
    fi
    exec 9>/pkg/.apk.lock
    flock 9
    ix-world run alpine apk add --no-progress "$@"
)

toybox() (
    stage=$(mktemp -d /bin/.toybox.XXXXXXXX)
    trap 'rm -rf "$stage"' EXIT
    cp "$1" "$stage/toybox"
    chmod 755 "$stage/toybox"
    applets=$("$stage/toybox")
    "$stage/toybox" --version
    busybox mv -fT "$stage/toybox" /bin/toybox
    for applet in $applets; do
        if [ ! -e "/bin/$applet" ] && [ ! -L "/bin/$applet" ]; then
            busybox ln -sT toybox "/bin/$applet"
        fi
    done
)

case ${0##*/} in
    git) set -- git "$@" ;;
esac
action=${1:-}
[ "$#" -eq 0 ] || shift
case $action in
    install) install "$@" ;;
    tools)
        install git openssh-client
        mkdir -p /usr/bin
        if [ ! -e /usr/bin/git ] && [ ! -L /usr/bin/git ]; then
            ln -sT /lib/ix/ix-kit /usr/bin/git
        fi
        ;;
    toybox) toybox "$1" ;;
    git)
        [ -x "$kit/usr/bin/git" ] || install git openssh-client
        export LD_LIBRARY_PATH="$kit/lib:$kit/usr/lib"
        export GIT_EXEC_PATH="$kit/usr/libexec/git-core" GIT_TEMPLATE_DIR="$kit/usr/share/git-core/templates"
        export GIT_SSH="${GIT_SSH:-$kit/usr/bin/ssh}"
        export GIT_SSL_CAINFO=/etc/ssl/cert.pem
        exec "$kit/usr/bin/git" "$@"
        ;;
    crane|tar)
        if [ "$action" = tar ]; then tool=$kit/bin/tar; else tool=$kit/usr/bin/crane; fi
        [ -x "$tool" ] || install "$action"
        export LD_LIBRARY_PATH="$kit/lib:$kit/usr/lib"
        exec "$tool" "$@"
        ;;
    *) printf '%s\n' 'usage: ix-kit install APK ... | tools | git ...' >&2; exit 2 ;;
esac
