#!/bin/sh
set -eu
case $1 in
    fetch)
        [ ! -e source/.git ] || exit 0
        exec /lib/ix/ix-kit git clone --depth 1 -- "$2" source
        ;;
    edit) exec "${EDITOR:-vi}" -- "$2" ;;
    ask)
        [ -n "$3" ] || { echo "Use REQUEST='your question'" >&2; exit 2; }
        {
            printf '%s\n' "IX recipe ($PWD/Makefile):"
            cat Makefile
            if [ "$2" != Makefile ]; then
                printf '\nSelected source (%s):\n' "$2"
                cat -- "$2"
            fi
        } | yhwh turn "$3. Propose a unified diff for review."
        ;;
    patch)
        [ -n "$2" ] || { echo 'Use PATCH=/path/to/changes.diff' >&2; exit 2; }
        patch=$(realpath -e -- "$2")
        /lib/ix/ix-kit git -C source apply --check -- "$patch"
        exec /lib/ix/ix-kit git -C source apply -- "$patch"
        ;;
esac
