#!/bin/sh
set -eu

test_dir=$(mktemp -d)
mkfifo "$test_dir/stop"
exec 3<>"$test_dir/stop"
DISPLAY= ix-world run arch sh -ec '
    Xvfb -displayfd 1 -screen 0 1280x800x24 -nolisten tcp &
    server=$!
    trap "kill $server 2>/dev/null || :; wait $server || :" EXIT
    read -r stop
' <&3 >"$test_dir/display" &
xvfb=$!
trap 'printf "\n" >&3; wait "$xvfb" || :; rm -rf "$test_dir"' EXIT

for delay in 1 2 3 4 5; do
    [ -s "$test_dir/display" ] && break
    sleep 1
done
test -s "$test_dir/display"
export DISPLAY=:$(cat "$test_dir/display")
unset XAUTHORITY
export YHWH_DATA_DIR="$test_dir/state" YHWH_CONFIG_HOME="$test_dir/config"

mkdir "$test_dir/work"
cd "$test_dir/work"
touch fixture
cat > "$test_dir/main.cjs" <<'JS'
const { app } = require('electron');
const fs = require('node:fs/promises');
const installed = '/pkg/arch/opt/yhwh/src/yhwh-default';
app.setAppPath(installed);

app.on('browser-window-created', (_, window) => {
  window.webContents.on('did-finish-load', async () => {
    if (!window.webContents.getURL().endsWith('/etc/default/index.html')) return;
    const deadline = Date.now() + 10000;
    try {
      while (Date.now() < deadline) {
        const ready = await window.webContents.executeJavaScript(`
          window.YHWH?.active().cwd === ${JSON.stringify(process.cwd())} &&
          YHWH.active().entries.some(entry => entry.name === 'fixture') &&
          !document.querySelector('#navigation-area').hidden &&
          !document.querySelector('#terminal-panel').hidden
        `);
        if (ready) {
          await window.webContents.executeJavaScript(`
            YHWH.active().terminal.input('pwd > terminal-cwd\\r', true)
          `);
          break;
        }
        await new Promise(resolve => setTimeout(resolve, 100));
      }
      while (Date.now() < deadline) {
        if ((await fs.readFile('terminal-cwd', 'utf8').catch(() => '')).trim() === process.cwd()) {
          console.log('YHWH El opened its file manager and terminal in ' + process.cwd());
          app.exit(0);
          return;
        }
        await new Promise(resolve => setTimeout(resolve, 100));
      }
      throw new Error('The file manager and terminal did not open in the calling directory.');
    } catch (error) {
      console.error(error);
      app.exit(1);
    }
  });
});
require(installed + '/app/main.cjs');
JS
timeout -k 5 30 yhwh el --smoke "$test_dir/main.cjs"
