#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: LD [--] PROGRAM [REQUEST ...]' \
        'Run a readable prose program with LD_RUNNER (default lordhavemercy).'
}

case "${1:-}" in
    -h|--help) usage; exit ;;
    --) shift ;;
esac
if [ "$#" -eq 0 ]; then
    usage >&2
    exit 2
fi

program=$1
shift
if [ ! -f "$program" ] && [ "${program#*/}" = "$program" ]; then
    if resolved=$(command -v -- "$program"); then
        program=$resolved
    fi
fi
if [ ! -f "$program" ] || [ ! -r "$program" ]; then
    printf 'LD: expected a readable prose program: %s\n' "$program" >&2
    exit 2
fi

if [ "${1:-}" = -- ]; then
    shift
fi
NSH_PROGRAM=$program exec "${LD_RUNNER:-lordhavemercy}" -- "$@"
