#!/bin/sh
set -eu
kit=/pkg/alpine
boot=/lib/ix/alpine

install() (
    mkdir -p /pkg
    exec 9>/pkg/.alpine.lock
    flock 9
    apk=$(mktemp)
    stage=
    trap 'rm -f "$apk"; if [ -n "$stage" ]; then rm -rf "$stage"; fi' EXIT
    gzip -dc "$boot/apk.gz" > "$apk"
    chmod 700 "$apk"
    if [ -f "$kit/.ix-seed" ]; then
        "$apk" --root "$kit" --no-progress add "$@"
    else
        [ ! -e "$kit" ] && [ ! -L "$kit" ] || exit 1
        stage=$(mktemp -d /pkg/.alpine.XXXXXX)
        chmod 755 "$stage"
        mkdir -p "$stage/etc/apk" "$stage/dev" "$stage/proc" "$stage/run" "$stage/sys" "$stage/tmp" "$stage/ix-src"
        chmod 1777 "$stage/tmp"
        cp -a "$boot/keys" "$boot/repositories" "$stage/etc/apk/"
        cp /etc/resolv.conf "$stage/etc/"
        "$apk" --root "$stage" --initdb --no-progress add alpine-base "$@"
        printf '%s\n' 'Alpine workshop' > "$stage/.ix-seed"
        busybox mv -T "$stage" "$kit"
    fi
    if [ ! -e /pkg/Makefile ]; then ln -s /lib/ix/pkg.mk /pkg/Makefile || [ -f /pkg/Makefile ]; fi
)

case ${0##*/} in
    git) set -- git "$@" ;;
esac
action=${1:-}
[ "$#" -eq 0 ] || shift
case $action in
    install) install "$@" ;;
    tools)
        install git openssh-client
        mkdir -p /usr/bin
        if [ ! -e /usr/bin/git ] && [ ! -L /usr/bin/git ]; then
            ln -sT /bin/ix-kit /usr/bin/git
        fi
        ;;
    git)
        [ -x "$kit/usr/bin/git" ] || install git openssh-client
        export LD_LIBRARY_PATH="$kit/lib:$kit/usr/lib"
        export GIT_EXEC_PATH="$kit/usr/libexec/git-core"
        export GIT_SSL_CAINFO=/etc/ssl/cert.pem
        exec "$kit/usr/bin/git" "$@"
        ;;
    crane|tar)
        if [ "$action" = tar ]; then tool=$kit/bin/tar; else tool=$kit/usr/bin/crane; fi
        [ -x "$tool" ] || install "$action"
        export LD_LIBRARY_PATH="$kit/lib:$kit/usr/lib"
        exec "$tool" "$@"
        ;;
    *) printf '%s\n' 'usage: ix-kit install APK ... | tools | git ...' >&2; exit 2 ;;
esac
