#!/bin/sh
set -eu
case ${0##*/} in
    law|lawd) effort=low ;;
    lorde) effort=high ;;
    lordylordydaddysforty) effort=max ;;
    *) effort=xhigh ;;
esac
mode=full
while [ "$#" -gt 0 ]; do
    case $1 in
        -f) mode=full ;;
        -i) mode=review ;;
        -n) mode=text ;;
        --|@@) shift; break ;;
        -h|--help)
            printf '%s\n' 'lord [-f|-i|-n] REQUEST' \
                '  -f  run shell steps as you (the default)' \
                '  -i  ask before each step' \
                '  -n  answer in text' \
                '  stdio and argv work as usual. Try gen --help.'
            exit ;;
        *) break ;;
    esac
    shift
done
exec gen agent "$effort" "$mode" "$@"
