#!/bin/sh
case "$1" in
    bound|renew)
        # udhcpc supplies a dotted netmask. ifconfig accepts it directly.
        busybox ifconfig "$interface" "$ip" netmask "$subnet" up
        for gateway in $router; do ip route replace default via "$gateway" dev "$interface"; break; done
        if [ -n "$dns" ]; then
            for server in $dns; do printf 'nameserver %s\n' "$server"; done > /etc/resolv.conf
        fi
        ;;
esac
