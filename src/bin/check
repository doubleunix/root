#!/bin/bash
set -euo pipefail
enter=$(dirname -- "$0")/enter
X11=0 "$enter" "$1" sh -ec "$(cat <<'CHECK'
    test "$PWD" = /
    test "$(id -u)" = 0
    test -z "$(ls -A /usr)"
    for command in apk bash cc codex curl git jq node pacman nix emerge python3; do
        if command -v "$command"; then exit 1; fi
    done
    for command in toybox sh make port LD '#!' SH ATA @ lord lord-run lord-log nsh NSH nhs NHS shn SHN; do
        command -v "$command"
    done
    test "$(stat -c %a /root)" = 700
    test "$(stat -c %a /etc/shadow)" = 600
    make -s -C /src ls | grep -F thedynamiclinker/nsh
    test "$(find /src -mindepth 1 -maxdepth 1 | wc -l)" -eq 2

    export LORD_LOG_DIR=/tmp/check-log
    printf 'stream\0data\n' > /tmp/input
    status=0
    lord-run sh -c 'cat; printf diagnostic >&2; exit 19' < /tmp/input > /tmp/output 2> /tmp/error || status=$?
    test "$status" -eq 19
    cmp /tmp/input /tmp/output
    lord-log stdin > /tmp/record
    cmp /tmp/input /tmp/record
    lord-log stdout > /tmp/record
    cmp /tmp/output /tmp/record
    test "$(lord-log status)" = 19
    test "$(lord-log stderr)" = diagnostic
    test "$(stat -c %a "$(lord-log path)")" = 700

    cat > /tmp/backend <<'BACKEND'
#!/bin/sh
set -eu
case "$*" in
    upper) test -r "$LORD_PROGRAM"; tr '[:lower:]' '[:upper:]' ;;
    hello) printf '%s %s\n' "$LORD_EFFORT" "$LORD_PERMISSION" ;;
    *'correct this phrase'*) printf '@code\nprintf "corrected"\n' ;;
    *) cat ;;
esac
BACKEND
    chmod 700 /tmp/backend
    export LORD_BACKEND=/tmp/backend
    test "$(law hello)" = 'low text'
    test "$(lord --permission read hello)" = 'medium read'
    test "$(lord-log permission)" = read
    test "$(printf 'aGk=' | @ base64 decode to stdout @ upper)" = HI
    test "$(nsh -m c -- 'correct this phrase')" = 'printf "corrected"'
    nsh -n 2 -c 'exit 19' && exit 1
    test "$(lord-log status)" = 19
    nsh -c 'echo native' >/tmp/native
    grep -qx native /tmp/native

    printf '#!/bin/LD\nInterpret this file\n' > /tmp/program
    chmod 700 /tmp/program
    test "$(/tmp/program hello)" = 'medium text'
    export LD_BINDIR=/tmp/bin
    printf '1: say shell words\n2: define builtins/say\n' > /tmp/speech
    shn --check /tmp/speech
    shn --link speak /tmp/speech
    /tmp/bin/speak > /tmp/speaking
    grep -qx 'shell words' /tmp/speaking
    grep -qx 'Write the rest of the line to standard output.' /tmp/speaking
    export SHN_HOME=/tmp/vocabulary
    mkdir -p "$SHN_HOME/etc"
    printf 'greet\tsay welcome\n' > "$SHN_HOME/etc/aliases"
    test "$(shn -n 2 -c '1: greet world')" = 'welcome world'
    printf 'say first\nundefined\n' > /tmp/undefined
    shn --check /tmp/undefined && exit 1
    printf '%s\n' 'ix: minimal base, ports, permissions, streams, loader and languages work'
CHECK
)"
