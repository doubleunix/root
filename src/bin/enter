#!/bin/bash
set -euo pipefail
if [[ ${1:-} != --inside ]]; then
    exec unshare --mount --propagation private -- "$0" --inside "$@"
fi
shift
root=$1
shift

mount --bind "$root" "$root"
mount --make-rprivate "$root"
mount -t proc proc "$root/proc"
mount -t sysfs -o ro sysfs "$root/sys"
mount -t tmpfs -o mode=0755 tmpfs "$root/run"
mount -t tmpfs -o mode=0755 tmpfs "$root/dev"
for dev in 'null 1 3' 'zero 1 5' 'full 1 7' 'random 1 8' 'urandom 1 9' 'tty 5 0'; do
    read -r name major minor <<< "$dev"
    mknod -m 666 "$root/dev/$name" c "$major" "$minor"
done
mkdir "$root/dev/pts"
mount -t devpts -o newinstance,ptmxmode=0666,mode=0620 devpts "$root/dev/pts"
mkdir "$root/dev/shm"
mount -t tmpfs -o mode=1777 tmpfs "$root/dev/shm"
ln -s pts/ptmx "$root/dev/ptmx"
ln -s /proc/self/fd "$root/dev/fd"
ln -s fd/0 "$root/dev/stdin"
ln -s fd/1 "$root/dev/stdout"
ln -s fd/2 "$root/dev/stderr"

display=
if [[ ${X11:-} == 1 || ( ${X11:-} != 0 && -n ${DISPLAY:-} ) ]]; then
    display=${DISPLAY:?X11=1 needs DISPLAY}
    if [[ ( $display == :* || $display == unix:* ) && -d /tmp/.X11-unix ]]; then
        mkdir -p "$root/tmp/.X11-unix"
        mount --bind /tmp/.X11-unix "$root/tmp/.X11-unix"
        mount -o remount,bind,ro "$root/tmp/.X11-unix"
    fi
    if [[ -r ${XAUTHORITY:-} ]]; then
        (umask 077; xauth -f "$XAUTHORITY" extract - "$display" > "$root/dev/shm/ix.Xauthority")
        for name in user yhwh; do
            uid=$(awk -F: -v name="$name" '$1 == name { print $3 }' "$root/etc/passwd")
            if [[ -n $uid ]]; then
                install -m 600 -o "$uid" "$root/dev/shm/ix.Xauthority" "$root/dev/shm/ix.Xauthority.$uid"
            fi
        done
    fi
fi

backend=
if [[ -n ${IX_GEN_SOCKET:-} ]]; then
    [[ -S $IX_GEN_SOCKET ]]
    touch "$root/run/gen"
    mount --bind "$IX_GEN_SOCKET" "$root/run/gen"
    backend=/lib/new-world/host
fi

if (($# == 0)); then
    if [[ -t 0 && -t 1 ]]; then set -- /bin/nsh
    else set -- /bin/sh -l; fi
fi
exec env -i PATH=/bin:/usr/bin HOME=/root TERM="${TERM:-dumb}" DISPLAY="$display" NO_COLOR="${NO_COLOR:-}" \
    LORD_BACKEND="$backend" GEN_URL="${GEN_URL:-}" GEN_MODEL="${GEN_MODEL:-}" GEN_AGENT="${GEN_AGENT:-}" \
    GEN_KEY="${GEN_KEY:-}" GEN_REASONING="${GEN_REASONING:-}" GIT_ROOT="${GIT_ROOT:-https://github.com}" \
    "$(command -v chroot)" "$root" /bin/sh -c '. /etc/profile; cd /; exec "$@"' ix "$@"
