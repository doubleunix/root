#!/usr/bin/env python3
"""Serve the caller's configured text backend on a private Unix socket."""
import os
import shutil
import socketserver
import subprocess
import sys
import tempfile
import threading


class Prompt(socketserver.StreamRequestHandler):
    def handle(self):
        limit = 1024 * 1024
        self.connection.settimeout(30)
        try:
            effort = self.rfile.readline(16).strip().decode("ascii")
            prompt = self.rfile.read(limit + 1)
            if effort not in ("none", "low", "medium", "high", "xhigh", "max") or len(prompt) > limit:
                self.wfile.write(b"2\n")
                return
            reply = subprocess.run(
                [self.server.backend],
                input=prompt,
                stdout=subprocess.PIPE,
                cwd=self.server.directory,
                env={**os.environ, "GEN_EFFORT": effort},
            )
        except (OSError, ValueError):
            self.wfile.write(b"69\n")
            return
        status = reply.returncode if reply.returncode >= 0 else 128 - reply.returncode
        self.wfile.write(f"{status}\n".encode("ascii"))
        self.wfile.write(reply.stdout)


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True


def main(backend, command):
    executable = shutil.which(backend)
    if executable is None:
        raise SystemExit(f"ix: GEN_HOST is not executable: {backend}")
    with tempfile.TemporaryDirectory(prefix="ix-gen-", dir="/tmp") as directory:
        address = os.path.join(directory, "gen")
        with Server(address, Prompt) as server:
            os.chmod(address, 0o600)
            server.backend = os.path.abspath(executable)
            server.directory = directory
            thread = threading.Thread(target=server.serve_forever, daemon=True)
            thread.start()
            try:
                return subprocess.call(command, env={**os.environ, "IX_GEN_SOCKET": address})
            finally:
                server.shutdown()
                thread.join()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1], sys.argv[2:]))
