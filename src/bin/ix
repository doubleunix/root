#!/bin/bash
set -euo pipefail

cd -- "$(dirname -- "$0")/.."
if [[ ${1:-} == chroot && -n ${GEN_HOST:-} && -z ${IX_GEN_SOCKET:-} ]]; then
    exec python3 bin/gen-host "$GEN_HOST" "$PWD/bin/ix" "$@"
fi
if [[ ${1:-} == chroot && ${X11:-1} != 0 && -n ${DISPLAY:-} ]]; then
    export XAUTHORITY=${XAUTHORITY:-$HOME/.Xauthority}
fi
if ((EUID != 0)); then
    mkdir -p -- "$OUT"
    exec sudo --preserve-env=OUT,DST,ENGINE,IMAGE,ROOT,ARCH,KERNEL,BOOT_MODULES,PORTS_SOURCE,PORTS_CACHE,IX_GEN_SOCKET,GEN_URL,GEN_MODEL,GEN_AGENT,GEN_KEY,GEN_REASONING,NO_COLOR,GIT_ROOT,TERM,X11,DISPLAY,XAUTHORITY -- "$PWD/bin/ix" "$@"
fi

action=$1
shift
generation=5
mkdir -p "$OUT"
umask 022

base() (
    # Export into a new tree. Buildx leaves obsolete files in an existing output.
    exec 8>"$OUT/base.lock"
    flock 8
    local sum stage file
    sum=$(for file in Dockerfile.base etc/busybox.config ../dst/src/toybox/{Makefile,config}; do
        sha256sum "$file" || exit
    done | cut -d' ' -f1)
    if [[ -f $OUT/base/.ix-base && $(<"$OUT/base/.ix-base") == "$sum" ]]; then return; fi
    if [[ -e $OUT/base && ! -f $OUT/base/.ix-base ]]; then
        printf 'ix: refusing to replace unmarked directory %s\n' "$OUT/base" >&2
        return 1
    fi
    stage=$(mktemp -d "$OUT/base.XXXXXXXX")
    trap 'rm -rf -- "$stage"' EXIT
    "$ENGINE" buildx build --target world --output "type=local,dest=$stage" -f Dockerfile.base ..
    printf '%s\n' "$sum" > "$stage/.ix-base"
    rm -rf -- "$OUT/base"
    mv -T -- "$stage" "$OUT/base"
)

accounts() (
    local root=$1 file seed current mode name uid gid home temp
    temp=$(mktemp -d "$root/etc/.accounts.XXXXXXXX")
    trap 'rm -rf -- "$temp"' EXIT
    for file in group passwd shadow; do
        seed=$DST/etc/$file
        [[ -f $seed ]] || continue
        current=$root/etc/$file
        [[ -f $current ]] || current=/dev/null
        # Keep passwords and local accounts. Refuse a name or ID collision
        # before changing any of the three account databases.
        awk -F: -v file="$file" '
            FILENAME == ARGV[1] {
                print
                names[$1] = $3
                ids[$3] = $1
                next
            }
            file != "shadow" && (($1 in names && names[$1] != $3) ||
                    ($3 in ids && ids[$3] != $1)) {
                printf "ix: account collision in %s for %s (%s)\n", file, $1, $3 > "/dev/stderr"
                exit 1
            }
            !($1 in names)
        ' "$current" "$seed" > "$temp/$file"
    done
    for file in group passwd shadow; do
        [[ -f $temp/$file ]] || continue
        mode=644
        if [[ $file == shadow ]]; then mode=600; fi
        chmod "$mode" "$temp/$file"
        if ! cmp -s "$temp/$file" "$root/etc/$file"; then
            mv -T -- "$temp/$file" "$root/etc/$file"
        fi
    done
    if [[ -f $DST/etc/passwd ]]; then
        while IFS=: read -r name _ uid gid _ home _; do
            if [[ $home == /home/* && ! -e $root$home ]]; then
                install -d -m 700 -o "$uid" -g "$gid" "$root$home"
            fi
        done < "$DST/etc/passwd"
    fi
)

overlay() (
    local root=$1
    install -d -m 755 "$root/src" "$root/lib/new-world" "$root/usr/bin"
    if [[ ! -e $root/usr/bin/env && ! -L $root/usr/bin/env ]]; then
        ln -s ../../bin/env "$root/usr/bin/env"
    fi
    install -m 644 "$DST/Makefile" "$root/"
    install -m 755 "$DST/init" "$root/"
    install -m 644 "$DST/etc/"{profile,hosts} "$root/etc/"
    install -m 644 "$DST/src/"{Makefile,ports.list} "$root/src/"
    install -m 755 "$DST/lib/new-world/host" "$root/lib/new-world/"
    install -m 755 "$DST/lib/ix/ix-dhcp" "$root/lib/new-world/dhcp"
    PREFIX=/ DESTDIR=$root bin/core install
    accounts "$root"
)

tools() (
    local root=$1 stage
    world "$root"
    exec 9>"$root.lock"
    flock 9
    stage=$(mktemp -d "$OUT/tools.XXXXXXXX")
    trap 'rm -rf -- "$stage"' EXIT
    "$ENGINE" buildx build --target port-tools --output "type=local,dest=$stage" -f Dockerfile.base ..
    rsync -a -- "$stage/" "$root/"
    install -d -m 755 "$root/lib/ix"
    install -m 755 "$DST/bin/"{ix-world,gen,yhwh} "$root/bin/"
    install -m 755 "$DST/lib/ix/"{ix-kit,ix-port,yhwh-el,yhwh-bash,electron,gen-codex} "$root/lib/ix/"
    install -m 644 "$DST/lib/ix/"{agent,borrow.mk,help.mk,pkg.mk,port.mk,targets.awk} "$root/lib/ix/"
    for recipe in alpine pacman nix emerge yhwh; do
        # Publish the recipes only. A host checkout of a fetched source may
        # contain build products or credentials.
        install -d -m 755 "$root/src/$recipe"
        install -m 644 "$DST/src/$recipe/Makefile" "$root/src/$recipe/"
    done
    install -m 755 "$DST/src/alpine/python" "$root/src/alpine/"
    install -m 755 "$DST/src/yhwh/"{check,desktop} "$root/src/yhwh/"
)

world() (
    local root=${1%/} stage
    if [[ $root != /* || $root == / || -L $root || $(realpath -m -- "$root") != "$root" ]]; then
        printf 'ix: use a canonical absolute root directory: %s\n' "$root" >&2
        exit 2
    fi
    mkdir -p -- "$(dirname -- "$root")"
    exec 9>"$root.lock"
    flock 9
    if [[ -f $root/etc/ix ]]; then
        if [[ $(<"$root/etc/ix") != "$generation" ]]; then
            printf 'ix: %s is an earlier world. Build the new base with ROOT=/another/path.\n' "$root" >&2
            exit 1
        fi
        if [[ $action == update ]]; then
            base
            (
                exec 8>"$OUT/base.lock"
                flock -s 8
                rsync -a --exclude=/.ix-base -- "$OUT/base/" "$root/"
            )
            overlay "$root"
        fi
        printf 'ix: %s is ready\n' "$root"
        return
    fi
    if [[ -e $root ]]; then
        printf 'ix: %s already exists. Select a fresh directory with ROOT=.\n' "$root" >&2
        exit 1
    fi
    base
    stage=$(mktemp -d "$root.build.XXXXXXXX")
    trap 'rm -rf -- "$stage"' EXIT
    (
        exec 8>"$OUT/base.lock"
        flock -s 8
        cp -a -- "$OUT/base/." "$stage/"
    )
    rm "$stage/.ix-base"
    chmod 755 "$stage"
    install -d -m 755 "$stage"/{dev,proc,sys,run,usr}
    install -d -m 1777 "$stage/tmp"
    install -d -m 700 "$stage/root"
    cp -L /etc/resolv.conf "$stage/etc/resolv.conf"
    overlay "$stage"
    printf '%s\n' "$generation" > "$stage/etc/ix"
    mv -T -- "$stage" "$root"
    printf 'ix: built %s\n' "$root"
)

image_paths() {
    # Keep local agent credentials and caches out of exports.
    find . -xdev \( -name .codex -o -name .claude -o -name '.claude.json*' \
        -o -path '*/.local/share/gen' -o -path './run/*' "$@" \) -prune -o -print0
}

export_image() (
    if [[ -z $ROOT ]]; then
        local stage
        stage=$(mktemp -d "$OUT/image.XXXXXXXX")
        trap 'rm -rf -- "$stage"' EXIT
        ROOT=$stage/root
    fi
    world "$ROOT"
    "$@"
)

boot_image() (
    "$ENGINE" build --target boot-tools -t ix:boot-tools -f Dockerfile.base ..
    boot=$(mktemp -d "$OUT/boot.XXXXXXXX")
    trap 'rm -rf -- "$boot"' EXIT
    "$ENGINE" run --rm ix:boot-tools tar -C / -cf - boot/vmlinuz-virt lib/modules usr/share/syslinux |
        tar -xf - -C "$boot"
    artifacts=("$OUT/ix.cpio.gz")
    if [[ $KERNEL == "$OUT/vmlinuz-virt" ]]; then
        cp "$boot/boot/vmlinuz-virt" "$KERNEL"
        artifacts+=("$KERNEL")
    fi
    for modules in "$boot"/lib/modules/*; do
        slim=$boot/slim/lib/modules/${modules##*/}
        mkdir -p "$slim"
        awk -v modules="$BOOT_MODULES" -f lib/boot-modules.awk "$modules/modules.dep" > "$slim/modules.dep"
        (
            cd "$modules"
            while IFS=: read -r module _; do
                mkdir -p "$slim/${module%/*}"
                cp "$module" "$slim/$module"
            done < "$slim/modules.dep"
            cp modules.builtin "$slim/"
        )
    done
    (
        cd "$ROOT"
        image_paths -o -path './lib/modules' | cpio --quiet -0 -o -H newc
        cd "$boot/slim"
        find lib/modules -print0 | cpio --quiet -0 -o -H newc
    ) | gzip -9 > "$OUT/ix.cpio.gz"
    if [[ $action == iso ]]; then
        mkdir -p "$boot/iso"
        cp "$KERNEL" "$boot/iso/vmlinuz"
        cp "$OUT/ix.cpio.gz" "$boot/iso/"
        cp etc/isolinux.cfg "$boot/iso/"
        cp "$boot/usr/share/syslinux/"{isolinux.bin,ldlinux.c32} "$boot/iso/"
        "$ENGINE" run --rm -v "$boot/iso:/media:rw" -v "$OUT:/out:rw" ix:boot-tools \
            xorriso -as mkisofs -o /out/ix.iso -V IX -b isolinux.bin -c boot.cat \
            -no-emul-boot -boot-load-size 4 -boot-info-table /media
        artifacts+=("$OUT/ix.iso")
    fi
    if [[ ${SUDO_UID:-0} != 0 ]]; then
        chown -- "$SUDO_UID:$SUDO_GID" "${artifacts[@]}"
    fi
)

container_image() (
    cd "$ROOT"
    image_paths | tar --null --no-recursion -cf - -T - |
        "$ENGINE" import --change 'WORKDIR /' --change 'CMD ["/bin/sh","-l"]' - "$IMAGE"
)

case "$action" in
    world|update) world "${ROOT:-/mnt/new-world}" ;;
    tools) tools "${ROOT:-/mnt/new-world}" ;;
    chroot)
        ROOT=${ROOT:-/mnt/new-world}
        world "$ROOT"
        exec bin/enter "$ROOT" "$@"
        ;;
    boot|iso)
        if [[ $ARCH != x86_64 ]]; then printf '%s\n' 'ix: this boot build targets x86_64' >&2; exit 2; fi
        export_image boot_image
        ;;
    import) export_image container_image ;;
    check)
        check=$(mktemp -d "$OUT/check.XXXXXXXX")
        trap 'rm -rf -- "$check"' EXIT
        world "$check/root"
        bin/check "$check/root"
        ;;
esac
