#!/bin/sh
set -eu
case ${1:-} in
    -h|--help)
        printf '%s\n' 'nsh [-c COMMAND] [REQUEST ...]' \
            'Ordinary shell at the prompt. Use @ for words or run a sudocode file with LD.'
        exit ;;
    -c|-lc) exec /bin/sh "$@" ;;
    '') exec /bin/sh -i ;;
    *) exec yhwh "$@" ;;
esac
